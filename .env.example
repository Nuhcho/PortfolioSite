# Template for local environment variables.
# Copy to .env.local and fill in real values. .env.local is gitignored —
# never commit real secrets, and never put a secret in a NEXT_PUBLIC_* var
# (those are inlined into the browser bundle).

# Public site URL, used for metadata and absolute links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Secrets (server-only; leave blank until used) ---
# CONTACT_FORM_API_KEY=
# ANALYTICS_TOKEN=
